{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch WebJSApp",
            "type": "node",
            "request": "launch",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "nodemon",
            "program": "index.js",
            "cwd": "${workspaceFolder}\\webJsApp",
            "console": "integratedTerminal"
        },
        {
            "name": "Launch WebApp",
            "type": "node-terminal",
            "request": "launch",
            // explorer.exe opens the default browser and works the same whether the integrated shell is bash, cmd or PowerShell.
            "command": "explorer.exe \"http://localhost:4200\"",
            "cwd": "${workspaceFolder}\\webApp",
            "preLaunchTask": "start-webapp"
        }
    ]
}
